# MMBC Environment Configuration

# HomeWizard P1 Meter
P1_HOST=http://192.168.1.50

# Battery 1
BATTERY_1_IP=192.168.1.101
BATTERY_1_ADDRESS=1
BATTERY_1_PORT = 502  # Default port for Modbus TCP

# Battery 2
# If you have a second battery, uncomment the following lines and set the correct IP and address
#BATTERY_2_IP=192.168.1.102
#BATTERY_2_ADDRESS=1
#BATTERY_2_PORT = 502  # Default port for Modbus TCP

MQTT_HOST=168.1.2
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=mmbc/virtual
MQTT_HA_DISCOVERY=true
MQTT_USERNAME = "mmbc"
MQTT_PASSWORD = "mmbc"

# General Settings
INTERVAL_SECONDS=3

# SELF_CONTROL_AVAILABLE controls whether selfcontrol mode is available.
# Set to false if your batteries do not support Modbus control release.
# SELF_CONTROL_AVAILABLE=true

# GRID_MAX_IMPORT_WATTS caps how much power may be drawn from the grid (in watts).
# Charging is throttled so the house consumption plus the battery charge power stays
# below this value. Useful for the Belgian capacity tariff (capaciteitstarief), where
# the grid fee is based on the highest 15-minute average import of the month.
# Requires P1_HOST to be set to work properly: without a meter the house consumption
# is unknown and only the total battery charge power is capped.
# Not set = no limit.
# GRID_MAX_IMPORT_WATTS=8000